{
  "manifest_version": 3,
  "name": "Bili-Bill",
  "version": "1.0.0",
  "description": "Bili-Bill：归档并分析你的B站内容消费，管理观看历史、收藏和动态账单",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://bilibili.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.bilibili.com/video/*"],
      "js": ["content/player-monitor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.bilibili.com/"],
      "js": ["content/sidebar-card.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bili-Bill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["dashboard/index.html"],
      "matches": ["*://www.bilibili.com/*"]
    }
  ]
}
